# Names and safe defaults only. Real values live in Codespaces secrets or Web/.env.local (git-ignored).
# Everything here is read by the Web API server; none of it is ever sent to the browser.

PORT=8788

# Local PostgreSQL sidecar from .devcontainer/docker-compose.yml (throwaway dev credentials).
DATABASE_URL=postgres://framebase:framebase@db:5432/framebase

# OpenRouter: chat, vision and image generation.
OPENROUTER_API_KEY=

# Framebase Cloudflare API. Use the development Worker and a scoped device token, never raw R2/D1 credentials.
FRAMEBASE_CLOUD_API_URL=
FRAMEBASE_CLOUD_API_TOKEN=
