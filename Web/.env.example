# Names and safe defaults only. Real values live in Codespaces secrets or Web/.env.local (git-ignored).
# Everything here is read by the Web API server; none of it is ever sent to the browser.

PORT=8788

# PostgreSQL (chats, boards, jobs). Not used yet; set when the library workspace milestone adds it.
DATABASE_URL=

# OpenRouter: chat, vision and image generation.
OPENROUTER_API_KEY=

# Framebase Cloudflare API. Use the development Worker and a scoped device token, never raw R2/D1 credentials.
FRAMEBASE_CLOUD_API_URL=
FRAMEBASE_CLOUD_PAIRING_SECRET=
# Stable name for this server's device record on the Worker.
FRAMEBASE_WEB_DEVICE_ID=framebase-web-studio
# Production only: set to true once Cloudflare Access / Entra sits in front of this server.
LIBRARY_ACCESS_PROTECTED=false
